NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sad_b3
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sad_b3
DB_USER=sad_user
DB_PASSWORD=sad_password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Queue
QUEUE_NAME=sad-b3-queue
QUEUE_CONCURRENCY=5

# B3 API
B3_API_URL=https://api.b3.com.br
B3_API_KEY=your_api_key_here

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h

# Scheduler
SCHEDULER_TIMEZONE=America/Sao_Paulo
SCHEDULER_B3_OPEN=09:00
SCHEDULER_B3_CLOSE=17:00